# Supabase configuration.
# Copy this file to `.env.local` and fill in the real values from:
# Supabase Dashboard -> Project Settings -> API
# (or: https://supabase.com/dashboard/project/<project-ref>/settings/api)

# Your Supabase project URL.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Either the classic anon key (JWT) or the newer publishable key can be used.
# The app checks ANON first, then falls back to PUBLISHABLE.
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
